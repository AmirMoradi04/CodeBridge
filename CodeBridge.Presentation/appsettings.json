{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=CodeBridgeDb;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;Application Name=CodeBridge;"
  },
  
  "Database": {
    "AutoMigrate": true
  },
  "Seed": {
    "AdminEmail": "admin@codebridge.local",
    "AdminPassword": "Admin@12345"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Security": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15
  },
  "Referral": {
    "RewardAmount": 50000
  },
  "Jwt": {
    "Issuer": "CodeBridge",
    "Audience": "CodeBridgeClient",
    "SecretKey": "REPLACE_ME_IN_PRODUCTION",
    "ExpirationMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    // ثبت در EventLog ویندوز نیاز به دسترسی مدیر دارد و در محیط توسعه غیرفعال است
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    }
  },
  "AllowedHosts": "*"
}
